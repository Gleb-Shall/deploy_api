# Beget API (обязательно)
BEGET_LOGIN=your_beget_login
BEGET_PASSWORD=your_beget_api_password
# Пароль API настраивается в панели Beget отдельно от пароля входа
# https://beget.com/ru/kb/api/obshhij-princzip-raboty-s-api

# API сервера (по умолчанию только localhost)
API_HOST=127.0.0.1
API_PORT=5000
API_DEBUG=False

# Защита API (рекомендуется)
API_KEY=your_strong_random_api_key_here

# Максимальная цена домена для покупки (руб)
MAX_DOMAIN_PRICE=200

# Опционально: IP для A-записи корня домена после покупки (домен будет указывать на этот IP)
# BEGET_DNS_APEX_IP=1.2.3.4

# Лимит покупок доменов (формат: "N per hour" или "N per minute")
# PURCHASE_RATE_LIMIT=5 per hour

# Ожидание применения DNS после установки A-записи (ответ только после проверки или таймаута)
# DNS_PROPAGATION_TIMEOUT=120
# DNS_PROPAGATION_INTERVAL=5
# DNS_APEX_TTL=300
