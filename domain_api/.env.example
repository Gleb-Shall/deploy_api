# Beget API (обязательно) — только проверка доступности и цены домена
BEGET_LOGIN=your_beget_login
BEGET_PASSWORD=your_beget_api_password
# Пароль API настраивается в панели Beget отдельно от пароля входа
# https://beget.com/ru/kb/api/obshhij-princzip-raboty-s-api

# API сервера (по умолчанию только localhost)
API_HOST=127.0.0.1
API_PORT=5000
API_DEBUG=False

# Защита API (рекомендуется)
API_KEY=your_strong_random_api_key_here

# Порог цены для предупреждения в ответе check (руб)
MAX_DOMAIN_PRICE=200
