#!/bin/bash
#
# post-receive хук для deploy при git push
# page_hash извлекается из имени bare repo (например 1d2637e8889b.git → 1d2637e8889b)
#

set -e

# GIT_DIR задаётся Git при вызове хука; canonicalize (убирает /. в конце)
REPO_ROOT="$(cd "${GIT_DIR:-$(cd "$(dirname "$0")/.." && pwd)}" && pwd)"
PAGE_HASH="$(basename "$REPO_ROOT" .git)"
# Docker tag не принимает пустое, "." и прочие некорректные значения
if [[ -z "$PAGE_HASH" || "$PAGE_HASH" == "." || "$PAGE_HASH" == ".." ]] || ! [[ "$PAGE_HASH" =~ ^[a-zA-Z0-9_.-]+$ ]]; then
  echo "[post-receive] ERROR: Invalid PAGE_HASH='$PAGE_HASH' (REPO_ROOT=$REPO_ROOT, GIT_DIR=$GIT_DIR)" >&2
  exit 1
fi
WORK_TREE="/opt/deploy/${PAGE_HASH}"
CONTAINER_NAME="deploy-${PAGE_HASH}"
IMAGE_NAME="deploy-${PAGE_HASH}"
REGISTRY_FILE="/opt/deploy/registry.json"
NGINX_DEPLOY_DIR="/etc/nginx/sites-available/deploy"

# Домен (из переменной окружения или файла конфига)
DOMAIN="${DOMAIN:-automatoria.ru}"
if [[ -f "/opt/deploy/domain.txt" ]]; then
  DOMAIN=$(cat /opt/deploy/domain.txt 2>/dev/null | head -1 || echo "$DOMAIN")
fi

log() { echo "[post-receive $PAGE_HASH] $*"; }

while read oldrev newrev refname; do
  branch="${refname#refs/heads/}"
  if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
    log "Push в $branch, деплой..."
    
    # Уникальный ID для этого деплоя (timestamp + PID процесса - всегда уникален)
    DEPLOY_ID="$(date +%s)-$$"
    REDIS_RESULT_KEY="deploy:done:${PAGE_HASH}:${DEPLOY_ID}"

    # Checkout в work tree
    mkdir -p "$WORK_TREE"
    GIT_DIR="$REPO_ROOT" GIT_WORK_TREE="$WORK_TREE" git checkout -f "$branch" 2>/dev/null || \
    GIT_DIR="$REPO_ROOT" GIT_WORK_TREE="$WORK_TREE" git checkout -f main 2>/dev/null || \
    GIT_DIR="$REPO_ROOT" GIT_WORK_TREE="$WORK_TREE" git checkout -f master

    # package.cache.json — только поля, влияющие на pnpm install (без name/description/version/scripts)
    if [[ -f "$WORK_TREE/package.json" ]] && command -v jq >/dev/null 2>&1; then
      jq -cS '
        def sort_keys: if type == "object" then to_entries | sort_by(.key) | map({key: .key, value: (.value | sort_keys)}) | from_entries elif type == "array" then map(sort_keys) else . end;
        . as $orig |
        {name:"cache",version:"0.0.0",
         dependencies:($orig.dependencies//{}),
         devDependencies:($orig.devDependencies//{}),
         optionalDependencies:($orig.optionalDependencies//{}),
         peerDependencies:($orig.peerDependencies//{}),
         overrides:($orig.overrides//{}),
         pnpm:($orig.pnpm//{}),
         resolutions:($orig.resolutions//{}),
         packageManager:($orig.packageManager),
         engines:($orig.engines//{}),
         dependenciesMeta:($orig.dependenciesMeta//{}),
         peerDependenciesMeta:($orig.peerDependenciesMeta//{}),
         workspaces:($orig.workspaces//[])}
        | with_entries(select(.value != null and .value != {} and .value != [] and .value != ""))
        | sort_keys
      ' "$WORK_TREE/package.json" > "$WORK_TREE/package.cache.json"
    else
      cp "$WORK_TREE/package.json" "$WORK_TREE/package.cache.json" 2>/dev/null || true
    fi

    # Base path и кастомный домен — нужны до генерации Dockerfile (для проверки sitemap)
    SITE_BASE="/${PAGE_HASH}/"
    CUSTOM_DOMAIN_LINE=""
    NO_PROTECTION=false
    if [[ -f "$WORK_TREE/domain" ]]; then
      CUSTOM_DOMAIN_LINE=$(head -n1 "$WORK_TREE/domain" 2>/dev/null | sed 's/^[[:space:]]*//;s/[[:space:]]*$//' || true)
      [[ -n "$CUSTOM_DOMAIN_LINE" ]] && SITE_BASE="/"
      if grep -qx "no_protection" "$WORK_TREE/domain" 2>/dev/null; then
        NO_PROTECTION=true
        log "Защита от парсинга отключена (флаг no_protection в файле domain)"
      fi
    fi

    # Copy CSS obfuscation script into work tree (included in Docker build context via COPY . .)
    # Skip if no_protection — Dockerfile falls back to: touch /app/css_bundle.txt
    if [[ "$NO_PROTECTION" == false ]]; then
      cp /opt/deploy_api/scripts/obfuscate_css.js "$WORK_TREE/obfuscate_css.js" 2>/dev/null || true
    fi

    # Dockerfile с pnpm + BuildKit (без # syntax= — встроенный frontend, без resolve docker.io)
    log "Dockerfile: pnpm + BuildKit"
    # Подстановки: __PAGE_HASH__, __CUSTOM_DOMAIN__ (для проверки sitemap при кастомном домене)
    sed -e "s/__PAGE_HASH__/$PAGE_HASH/g" -e "s|__CUSTOM_DOMAIN__|${CUSTOM_DOMAIN_LINE:-}|g" << 'DOCKERFILE' > "$WORK_TREE/Dockerfile"
ARG NODE_IMAGE=deploy-node:22-alpine
ARG NGINX_IMAGE=deploy-nginx:alpine
FROM ${NODE_IMAGE} AS builder
RUN corepack enable && corepack prepare pnpm@10.29.3 --activate
WORKDIR /app
COPY package.cache.json package.json
COPY pnpm-lock.yaml* ./
RUN echo 'dangerously-allow-all-builds=true' >> .npmrc
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    env CI=1 NO_UPDATE_NOTIFIER=1 sh -c '(test -f pnpm-lock.yaml && pnpm install --frozen-lockfile --prefer-offline || pnpm install --prefer-offline)'
COPY . .
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    --mount=type=cache,target=/app/.astro,id=astro-__PAGE_HASH__ \
    env CI=1 PAGE_HASH=__PAGE_HASH__ pnpm run build
RUN test -d dist || (echo "ERROR: dist not found" && exit 1)
    RUN if [ -n "__CUSTOM_DOMAIN__" ]; then test -f dist/sitemap.xml || test -f dist/sitemap-index.xml || (echo "Warning: Sitemap not found in dist/. Search engines may not index all pages." >&2); fi
RUN if [ -f /app/obfuscate_css.js ]; then cp /app/obfuscate_css.js /tmp/obfuscate_css.cjs && node /tmp/obfuscate_css.cjs /app/dist __PAGE_HASH__; else touch /app/css_bundle.txt; fi

FROM ${NGINX_IMAGE}
COPY --from=builder /app/dist /usr/share/nginx/html
COPY --from=builder /app/css_bundle.txt /css_bundle.txt
RUN echo 'server { listen 8000; root /usr/share/nginx/html; index index.html; location = /sitemap.xml { default_type application/xml; try_files /sitemap-index.xml /sitemap.xml =404; } location / { try_files $uri $uri/ /index.html; } gzip on; }' > /etc/nginx/conf.d/default.conf
EXPOSE 8000
CMD ["nginx", "-g", "daemon off;"]
DOCKERFILE

    # .dockerignore
    cat > "$WORK_TREE/.dockerignore" << 'DOCKERIGNORE'
node_modules
.git
dist
.astro
*.log
.env
DOCKERIGNORE

    # SEO: при кастомном домене добавляем @astrojs/sitemap в зависимости (если ещё нет)
    # Важно: патчим и package.cache.json, и package.json — в образе COPY . . перезаписывает файлы, pnpm install читает package.json
    if [[ -n "$CUSTOM_DOMAIN_LINE" ]] && command -v jq >/dev/null 2>&1; then
      SITEMAP_ADDED=false
      for pkg in "$WORK_TREE/package.cache.json" "$WORK_TREE/package.json"; do
        [[ -f "$pkg" ]] || continue
        if ! jq -e '.dependencies["@astrojs/sitemap"]' "$pkg" >/dev/null 2>&1; then
          jq '.dependencies["@astrojs/sitemap"] = "^3.0.0"' "$pkg" > "${pkg}.tmp" && mv "${pkg}.tmp" "$pkg"
          log "Добавлена зависимость @astrojs/sitemap для SEO в $(basename "$pkg")"
          SITEMAP_ADDED=true
        fi
      done
      [[ "$SITEMAP_ADDED" == true ]] && rm -f "$WORK_TREE/pnpm-lock.yaml" 2>/dev/null && log "Lockfile сброшен для установки @astrojs/sitemap в образе"
    fi
    # Генерируем astro.config.mjs с правильным base path
    log "Генерация astro.config.mjs с base: '${SITE_BASE}'"
    if [[ -f "$WORK_TREE/astro.config.mjs" ]]; then
      cp "$WORK_TREE/astro.config.mjs" "$WORK_TREE/astro.config.mjs.orig"
      if grep -q "base:" "$WORK_TREE/astro.config.mjs"; then
        sed -i.bak "s|base:.*|base: '${SITE_BASE}',|g" "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
        sed -i '' "s|base:.*|base: '${SITE_BASE}',|g" "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
        sed "s|base:.*|base: '${SITE_BASE}',|g" "$WORK_TREE/astro.config.mjs.orig" > "$WORK_TREE/astro.config.mjs"
      elif grep -q "site:" "$WORK_TREE/astro.config.mjs"; then
        sed -i.bak "/site:/a\\
	base: '${SITE_BASE}'," "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
        sed -i '' "/site:/a\\
	base: '${SITE_BASE}'," "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
        awk -v b="${SITE_BASE}" '/site:/ {print; print "\tbase: \047" b "\047,"; next} {print}' "$WORK_TREE/astro.config.mjs.orig" > "$WORK_TREE/astro.config.mjs"
      else
        sed -i.bak "/defineConfig({/a\\
	base: '${SITE_BASE}'," "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
        sed -i '' "/defineConfig({/a\\
	base: '${SITE_BASE}'," "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
        awk -v b="${SITE_BASE}" '/defineConfig({/ {print; print "\tbase: \047" b "\047,"; next} {print}' "$WORK_TREE/astro.config.mjs.orig" > "$WORK_TREE/astro.config.mjs"
      fi
      rm -f "$WORK_TREE/astro.config.mjs.orig" "$WORK_TREE/astro.config.mjs.bak" 2>/dev/null || true
      # SEO: при кастомном домене добавляем site и sitemap в существующий конфиг (если ещё нет)
      if [[ -n "$CUSTOM_DOMAIN_LINE" ]]; then
        grep -q "from '@astrojs/sitemap'" "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
          sed -i.bak "1a import sitemap from '@astrojs/sitemap';" "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
          sed -i '' "1a\\
import sitemap from '@astrojs/sitemap';
" "$WORK_TREE/astro.config.mjs" 2>/dev/null || true
        grep -q "site:" "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
          sed -i.bak "s|base:.*|&\n  site: 'https://${CUSTOM_DOMAIN_LINE}/',|" "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
          awk -v d="${CUSTOM_DOMAIN_LINE}" '/base:/ {print; print "  site: '\''https://" d "/'\'',"; next} {print}' "$WORK_TREE/astro.config.mjs" > "$WORK_TREE/astro.config.mjs.tmp" && mv "$WORK_TREE/astro.config.mjs.tmp" "$WORK_TREE/astro.config.mjs" 2>/dev/null || true
        # integrations: добавляем sitemap() — одна строка (integrations: [) или перенос (integrations:\n  [)
        if ! grep -q "sitemap()" "$WORK_TREE/astro.config.mjs" 2>/dev/null; then
          if grep -q "integrations:" "$WORK_TREE/astro.config.mjs" 2>/dev/null; then
            # Одна строка: integrations: [ или integrations:[
            sed -i.bak 's|integrations:[[:space:]]*\[|integrations: [sitemap(), |' "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
            sed -i '' 's|integrations:[[:space:]]*\[|integrations: [sitemap(), |' "$WORK_TREE/astro.config.mjs" 2>/dev/null || true
            # Многострочный вариант: integrations: и на следующей строке [
            if ! grep -q "sitemap()" "$WORK_TREE/astro.config.mjs" 2>/dev/null; then
              awk '/integrations:/ {f=1; print; next} f && /\[/ { sub(/\[/, "[sitemap(), "); f=0 } {print}' "$WORK_TREE/astro.config.mjs" > "$WORK_TREE/astro.config.mjs.tmp" && mv "$WORK_TREE/astro.config.mjs.tmp" "$WORK_TREE/astro.config.mjs" 2>/dev/null || true
            fi
            grep -q "sitemap()" "$WORK_TREE/astro.config.mjs" 2>/dev/null && log "Добавлен sitemap() в integrations (astro.config.mjs)"
          else
            awk -v d="${CUSTOM_DOMAIN_LINE}" '/site:/ {print; print "  integrations: [sitemap()],"; next} {print}' "$WORK_TREE/astro.config.mjs" > "$WORK_TREE/astro.config.mjs.tmp" && mv "$WORK_TREE/astro.config.mjs.tmp" "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
            awk '/base:/ {print; print "  integrations: [sitemap()],"; next} {print}' "$WORK_TREE/astro.config.mjs" > "$WORK_TREE/astro.config.mjs.tmp" && mv "$WORK_TREE/astro.config.mjs.tmp" "$WORK_TREE/astro.config.mjs" 2>/dev/null || true
            log "Добавлена строка integrations: [sitemap()] в astro.config.mjs"
          fi
        fi
        rm -f "$WORK_TREE/astro.config.mjs.bak" 2>/dev/null || true
      fi
    elif [[ -f "$WORK_TREE/astro.config.ts" ]]; then
      # Патчим .ts на месте (не копируем в .mjs — иначе аннотации типов ломают загрузку)
      ASTRO_CFG="$WORK_TREE/astro.config.ts"
      cp "$ASTRO_CFG" "$ASTRO_CFG.orig"
      if grep -q "base:" "$ASTRO_CFG"; then
        sed -i.bak "s|base:.*|base: '${SITE_BASE}',|g" "$ASTRO_CFG" 2>/dev/null || \
        sed -i '' "s|base:.*|base: '${SITE_BASE}',|g" "$ASTRO_CFG" 2>/dev/null || \
        sed "s|base:.*|base: '${SITE_BASE}',|g" "$ASTRO_CFG.orig" > "$ASTRO_CFG"
      else
        sed -i.bak "/defineConfig({/a\\
	base: '${SITE_BASE}'," "$ASTRO_CFG" 2>/dev/null || \
        sed -i '' "/defineConfig({/a\\
	base: '${SITE_BASE}'," "$ASTRO_CFG" 2>/dev/null || \
        awk -v b="${SITE_BASE}" '/defineConfig({/ {print; print "\tbase: \047" b "\047,"; next} {print}' "$ASTRO_CFG.orig" > "$ASTRO_CFG"
      fi
      rm -f "$ASTRO_CFG.orig" "$ASTRO_CFG.bak" 2>/dev/null || true
      if [[ -n "$CUSTOM_DOMAIN_LINE" ]]; then
        grep -q "from '@astrojs/sitemap'" "$ASTRO_CFG" 2>/dev/null || \
          sed -i.bak "1a import sitemap from '@astrojs/sitemap';" "$ASTRO_CFG" 2>/dev/null || \
          sed -i '' "1a\\
import sitemap from '@astrojs/sitemap';
" "$ASTRO_CFG" 2>/dev/null || true
        grep -q "site:" "$ASTRO_CFG" 2>/dev/null || \
          awk -v d="${CUSTOM_DOMAIN_LINE}" '/base:/ {print; print "  site: '\''https://" d "/'\'',"; next} {print}' "$ASTRO_CFG" > "$ASTRO_CFG.tmp" && mv "$ASTRO_CFG.tmp" "$ASTRO_CFG" 2>/dev/null || true
        if ! grep -q "sitemap()" "$ASTRO_CFG" 2>/dev/null; then
          if grep -q "integrations:" "$ASTRO_CFG" 2>/dev/null; then
            sed -i.bak 's|integrations:[[:space:]]*\[|integrations: [sitemap(), |' "$ASTRO_CFG" 2>/dev/null || \
            sed -i '' 's|integrations:[[:space:]]*\[|integrations: [sitemap(), |' "$ASTRO_CFG" 2>/dev/null || true
            grep -q "sitemap()" "$ASTRO_CFG" 2>/dev/null || \
              awk '/integrations:/ {f=1; print; next} f && /\[/ { sub(/\[/, "[sitemap(), "); f=0 } {print}' "$ASTRO_CFG" > "$ASTRO_CFG.tmp" && mv "$ASTRO_CFG.tmp" "$ASTRO_CFG" 2>/dev/null || true
          else
            awk '/site:/ {print; print "  integrations: [sitemap()],"; next} {print}' "$ASTRO_CFG" > "$ASTRO_CFG.tmp" && mv "$ASTRO_CFG.tmp" "$ASTRO_CFG" 2>/dev/null || \
            awk '/base:/ {print; print "  integrations: [sitemap()],"; next} {print}' "$ASTRO_CFG" > "$ASTRO_CFG.tmp" && mv "$ASTRO_CFG.tmp" "$ASTRO_CFG" 2>/dev/null || true
          fi
          grep -q "sitemap()" "$ASTRO_CFG" 2>/dev/null && log "Добавлен sitemap() в integrations (astro.config.ts)"
        fi
        rm -f "$ASTRO_CFG.bak" 2>/dev/null || true
      fi
    else
      # Если конфига нет, создаём базовый (base уже выбран выше по файлу domain)
      if [[ -n "$CUSTOM_DOMAIN_LINE" ]]; then
        sed -e "s|__SITE_BASE__|$SITE_BASE|g" -e "s|__SITE_URL__|https://${CUSTOM_DOMAIN_LINE}/|g" << 'ASTROCONFIG' > "$WORK_TREE/astro.config.mjs"
// @ts-check
import { defineConfig } from 'astro/config';
import sitemap from '@astrojs/sitemap';

// Автоматически сгенерировано при деплое (с sitemap для SEO)
export default defineConfig({
  base: '__SITE_BASE__',
  site: '__SITE_URL__',
  integrations: [sitemap()],
  output: 'static',
  trailingSlash: 'never',
  compressHTML: true
});
ASTROCONFIG
      else
        sed "s|__SITE_BASE__|$SITE_BASE|g" << 'ASTROCONFIG' > "$WORK_TREE/astro.config.mjs"
// @ts-check
import { defineConfig } from 'astro/config';

// Автоматически сгенерировано при деплое
export default defineConfig({
  base: '__SITE_BASE__',
  output: 'static',
  trailingSlash: 'never',
  compressHTML: true
});
ASTROCONFIG
      fi
    fi

    # Очередь Redis (воркер ограничен 2 одновременными деплоями)
    REDIS_HOST="${REDIS_HOST:-127.0.0.1}"
    REDIS_PORT="${REDIS_PORT:-6379}"
    DEPLOY_TIMEOUT="${DEPLOY_TIMEOUT:-300}"  # 5 минут по умолчанию
    
    # Передаём PAGE_HASH и DEPLOY_ID в очередь (JSON)
    DEPLOY_META="{\"hash\":\"${PAGE_HASH}\",\"deploy_id\":\"${DEPLOY_ID}\"}"
    
    if redis-cli -h "$REDIS_HOST" -p "$REDIS_PORT" RPUSH deploy_queue "$DEPLOY_META" >/dev/null 2>&1; then
      log "Добавлено в очередь (deploy_id: ${DEPLOY_ID}), ожидание завершения деплоя..."
      
      # Ждём результат через BLPOP (блокирующее ожидание)
      # При ошибке сборки воркер пушит одно значение: "failed\n" + вывод сборки (без отдельного ключа)
      RESULT=$(timeout "$DEPLOY_TIMEOUT" redis-cli -h "$REDIS_HOST" -p "$REDIS_PORT" --raw \
        BLPOP "${REDIS_RESULT_KEY}" "$DEPLOY_TIMEOUT" 2>/dev/null | tail -n +2 || echo "timeout")
      
      if [[ "$RESULT" == "ok" ]]; then
        if [[ -n "${CUSTOM_DOMAIN_LINE:-}" ]]; then
          DEPLOY_URL="https://${CUSTOM_DOMAIN_LINE}/"
        else
          DEPLOY_URL="https://${DOMAIN}/${PAGE_HASH}/"
        fi
        log "Деплой завершён успешно. Сайт: ${DEPLOY_URL}"
        echo "DEPLOY_URL:${DEPLOY_URL}" >&2
      elif [[ "$RESULT" == "failed" ]]; then
        log "Ошибка деплоя"
        echo "ERROR: Деплой завершился с ошибкой." >&2
        exit 1
      elif [[ "$RESULT" == "failed"* ]]; then
        log "Ошибка деплоя"
        echo "ERROR: Деплой завершился с ошибкой." >&2
        printf '%s' "${RESULT#failed$'\n'}" >&2
        exit 1
      else
        log "Таймаут ожидания деплоя (возможно, деплой ещё выполняется)"
        echo "WARNING: Таймаут ожидания деплоя (возможно, деплой ещё выполняется). Проверьте логи на сервере." >&2
        # Не возвращаем ошибку, т.к. деплой может завершиться позже
      fi
    else
      log "Redis недоступен, деплой напрямую..."
      if ! /opt/deploy_api/scripts/deploy_single.sh "$PAGE_HASH"; then
        exit 1
      fi
      if [[ -n "${CUSTOM_DOMAIN_LINE:-}" ]]; then
        echo "DEPLOY_URL:https://${CUSTOM_DOMAIN_LINE}/" >&2
      else
        echo "DEPLOY_URL:https://${DOMAIN}/${PAGE_HASH}/" >&2
      fi
    fi
  fi
done

exit 0
