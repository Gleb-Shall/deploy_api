#!/bin/bash
#
# post-receive хук для deploy при git push
# page_hash извлекается из имени bare repo (например 1d2637e8889b.git → 1d2637e8889b)
#

set -e

# GIT_DIR задаётся Git при вызове хука; canonicalize (убирает /. в конце)
REPO_ROOT="$(cd "${GIT_DIR:-$(cd "$(dirname "$0")/.." && pwd)}" && pwd)"
PAGE_HASH="$(basename "$REPO_ROOT" .git)"
# Docker tag не принимает пустое, "." и прочие некорректные значения
if [[ -z "$PAGE_HASH" || "$PAGE_HASH" == "." || "$PAGE_HASH" == ".." ]] || ! [[ "$PAGE_HASH" =~ ^[a-zA-Z0-9_.-]+$ ]]; then
  echo "[post-receive] ERROR: Invalid PAGE_HASH='$PAGE_HASH' (REPO_ROOT=$REPO_ROOT, GIT_DIR=$GIT_DIR)" >&2
  exit 1
fi
WORK_TREE="/opt/deploy/${PAGE_HASH}"
CONTAINER_NAME="deploy-${PAGE_HASH}"
IMAGE_NAME="deploy-${PAGE_HASH}"
REGISTRY_FILE="/opt/deploy/registry.json"
NGINX_DEPLOY_DIR="/etc/nginx/sites-available/deploy"

log() { echo "[post-receive $PAGE_HASH] $*"; }

while read oldrev newrev refname; do
  branch="${refname#refs/heads/}"
  if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
    log "Push в $branch, деплой..."

    # Checkout в work tree
    mkdir -p "$WORK_TREE"
    GIT_DIR="$REPO_ROOT" GIT_WORK_TREE="$WORK_TREE" git checkout -f "$branch" 2>/dev/null || \
    GIT_DIR="$REPO_ROOT" GIT_WORK_TREE="$WORK_TREE" git checkout -f main 2>/dev/null || \
    GIT_DIR="$REPO_ROOT" GIT_WORK_TREE="$WORK_TREE" git checkout -f master

    # package.cache.json — только поля, влияющие на pnpm install (без name/description/version/scripts)
    if [[ -f "$WORK_TREE/package.json" ]] && command -v jq >/dev/null 2>&1; then
      jq -cS '
        def sort_keys: if type == "object" then to_entries | sort_by(.key) | map({key: .key, value: (.value | sort_keys)}) | from_entries elif type == "array" then map(sort_keys) else . end;
        . as $orig |
        {name:"cache",version:"0.0.0",
         dependencies:($orig.dependencies//{}),
         devDependencies:($orig.devDependencies//{}),
         optionalDependencies:($orig.optionalDependencies//{}),
         peerDependencies:($orig.peerDependencies//{}),
         overrides:($orig.overrides//{}),
         pnpm:($orig.pnpm//{}),
         resolutions:($orig.resolutions//{}),
         packageManager:($orig.packageManager),
         engines:($orig.engines//{}),
         dependenciesMeta:($orig.dependenciesMeta//{}),
         peerDependenciesMeta:($orig.peerDependenciesMeta//{}),
         workspaces:($orig.workspaces//[])}
        | with_entries(select(.value != null and .value != {} and .value != [] and .value != ""))
        | sort_keys
      ' "$WORK_TREE/package.json" > "$WORK_TREE/package.cache.json"
    else
      cp "$WORK_TREE/package.json" "$WORK_TREE/package.cache.json" 2>/dev/null || true
    fi

    # Dockerfile с pnpm + BuildKit (без # syntax= — встроенный frontend, без resolve docker.io)
    log "Dockerfile: pnpm + BuildKit"
    # Quoted heredoc: ${NODE_IMAGE} остаётся как есть для Docker. $PAGE_HASH подставляем отдельно.
    sed "s/__PAGE_HASH__/$PAGE_HASH/g" << 'DOCKERFILE' > "$WORK_TREE/Dockerfile"
ARG NODE_IMAGE=deploy-node:20-alpine
ARG NGINX_IMAGE=deploy-nginx:alpine
FROM ${NODE_IMAGE} AS builder
RUN corepack enable && corepack prepare pnpm@10.29.3 --activate
WORKDIR /app
COPY package.cache.json package.json
COPY pnpm-lock.yaml* ./
RUN echo 'dangerously-allow-all-builds=true' >> .npmrc
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    env CI=1 NO_UPDATE_NOTIFIER=1 sh -c '(test -f pnpm-lock.yaml && pnpm install --frozen-lockfile --prefer-offline || pnpm install --prefer-offline)'
COPY . .
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    --mount=type=cache,target=/app/.astro,id=astro-__PAGE_HASH__ \
    env CI=1 pnpm run build
RUN test -d dist || (echo "ERROR: dist not found" && exit 1)

FROM ${NGINX_IMAGE}
COPY --from=builder /app/dist /usr/share/nginx/html
RUN echo 'server { listen 8000; root /usr/share/nginx/html; index index.html; location / { try_files $uri $uri/ /index.html; } gzip on; }' > /etc/nginx/conf.d/default.conf
EXPOSE 8000
CMD ["nginx", "-g", "daemon off;"]
DOCKERFILE

    # .dockerignore
    cat > "$WORK_TREE/.dockerignore" << 'DOCKERIGNORE'
node_modules
.git
dist
.astro
*.log
.env
DOCKERIGNORE

    # Очередь Redis (воркер ограничен 2 одновременными деплоями)
    REDIS_HOST="${REDIS_HOST:-127.0.0.1}"
    REDIS_PORT="${REDIS_PORT:-6379}"
    if redis-cli -h "$REDIS_HOST" -p "$REDIS_PORT" RPUSH deploy_queue "$PAGE_HASH" >/dev/null 2>&1; then
      log "Добавлено в очередь. Сайт: https://DOMAIN/${PAGE_HASH}/"
    else
      log "Redis недоступен, деплой напрямую..."
      /opt/deploy_api/scripts/deploy_single.sh "$PAGE_HASH"
    fi
  fi
done

exit 0
