#!/bin/bash
#
# post-receive хук для deploy при git push
# page_hash извлекается из имени bare repo (например 1d2637e8889b.git → 1d2637e8889b)
#

set -e

# GIT_DIR задаётся Git при вызове хука; canonicalize (убирает /. в конце)
REPO_ROOT="$(cd "${GIT_DIR:-$(cd "$(dirname "$0")/.." && pwd)}" && pwd)"
PAGE_HASH="$(basename "$REPO_ROOT" .git)"
# Docker tag не принимает пустое, "." и прочие некорректные значения
if [[ -z "$PAGE_HASH" || "$PAGE_HASH" == "." || "$PAGE_HASH" == ".." ]] || ! [[ "$PAGE_HASH" =~ ^[a-zA-Z0-9_.-]+$ ]]; then
  echo "[post-receive] ERROR: Invalid PAGE_HASH='$PAGE_HASH' (REPO_ROOT=$REPO_ROOT, GIT_DIR=$GIT_DIR)" >&2
  exit 1
fi
WORK_TREE="/opt/deploy/${PAGE_HASH}"
CONTAINER_NAME="deploy-${PAGE_HASH}"
IMAGE_NAME="deploy-${PAGE_HASH}"
REGISTRY_FILE="/opt/deploy/registry.json"
NGINX_DEPLOY_DIR="/etc/nginx/sites-available/deploy"

# Домен (из переменной окружения или файла конфига)
DOMAIN="${DOMAIN:-automatoria.ru}"
if [[ -f "/opt/deploy/domain.txt" ]]; then
  DOMAIN=$(cat /opt/deploy/domain.txt 2>/dev/null | head -1 || echo "$DOMAIN")
fi

log() { echo "[post-receive $PAGE_HASH] $*"; }

while read oldrev newrev refname; do
  branch="${refname#refs/heads/}"
  if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
    log "Push в $branch, деплой..."
    
    # Уникальный ID для этого деплоя (timestamp + PID процесса - всегда уникален)
    DEPLOY_ID="$(date +%s)-$$"
    REDIS_RESULT_KEY="deploy:done:${PAGE_HASH}:${DEPLOY_ID}"

    # Checkout в work tree
    mkdir -p "$WORK_TREE"
    GIT_DIR="$REPO_ROOT" GIT_WORK_TREE="$WORK_TREE" git checkout -f "$branch" 2>/dev/null || \
    GIT_DIR="$REPO_ROOT" GIT_WORK_TREE="$WORK_TREE" git checkout -f main 2>/dev/null || \
    GIT_DIR="$REPO_ROOT" GIT_WORK_TREE="$WORK_TREE" git checkout -f master

    # package.cache.json — только поля, влияющие на pnpm install (без name/description/version/scripts)
    if [[ -f "$WORK_TREE/package.json" ]] && command -v jq >/dev/null 2>&1; then
      jq -cS '
        def sort_keys: if type == "object" then to_entries | sort_by(.key) | map({key: .key, value: (.value | sort_keys)}) | from_entries elif type == "array" then map(sort_keys) else . end;
        . as $orig |
        {name:"cache",version:"0.0.0",
         dependencies:($orig.dependencies//{}),
         devDependencies:($orig.devDependencies//{}),
         optionalDependencies:($orig.optionalDependencies//{}),
         peerDependencies:($orig.peerDependencies//{}),
         overrides:($orig.overrides//{}),
         pnpm:($orig.pnpm//{}),
         resolutions:($orig.resolutions//{}),
         packageManager:($orig.packageManager),
         engines:($orig.engines//{}),
         dependenciesMeta:($orig.dependenciesMeta//{}),
         peerDependenciesMeta:($orig.peerDependenciesMeta//{}),
         workspaces:($orig.workspaces//[])}
        | with_entries(select(.value != null and .value != {} and .value != [] and .value != ""))
        | sort_keys
      ' "$WORK_TREE/package.json" > "$WORK_TREE/package.cache.json"
    else
      cp "$WORK_TREE/package.json" "$WORK_TREE/package.cache.json" 2>/dev/null || true
    fi

    # Dockerfile с pnpm + BuildKit (без # syntax= — встроенный frontend, без resolve docker.io)
    log "Dockerfile: pnpm + BuildKit"
    # Quoted heredoc: ${NODE_IMAGE} остаётся как есть для Docker. $PAGE_HASH подставляем отдельно.
    sed "s/__PAGE_HASH__/$PAGE_HASH/g" << 'DOCKERFILE' > "$WORK_TREE/Dockerfile"
ARG NODE_IMAGE=deploy-node:20-alpine
ARG NGINX_IMAGE=deploy-nginx:alpine
FROM ${NODE_IMAGE} AS builder
RUN corepack enable && corepack prepare pnpm@10.29.3 --activate
WORKDIR /app
COPY package.cache.json package.json
COPY pnpm-lock.yaml* ./
RUN echo 'dangerously-allow-all-builds=true' >> .npmrc
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    env CI=1 NO_UPDATE_NOTIFIER=1 sh -c '(test -f pnpm-lock.yaml && pnpm install --frozen-lockfile --prefer-offline || pnpm install --prefer-offline)'
COPY . .
RUN --mount=type=cache,target=/root/.local/share/pnpm/store \
    --mount=type=cache,target=/app/.astro,id=astro-__PAGE_HASH__ \
    env CI=1 PAGE_HASH=__PAGE_HASH__ pnpm run build
RUN test -d dist || (echo "ERROR: dist not found" && exit 1)

FROM ${NGINX_IMAGE}
COPY --from=builder /app/dist /usr/share/nginx/html
RUN echo 'server { listen 8000; root /usr/share/nginx/html; index index.html; location / { try_files $uri $uri/ /index.html; } gzip on; }' > /etc/nginx/conf.d/default.conf
EXPOSE 8000
CMD ["nginx", "-g", "daemon off;"]
DOCKERFILE

    # .dockerignore
    cat > "$WORK_TREE/.dockerignore" << 'DOCKERIGNORE'
node_modules
.git
dist
.astro
*.log
.env
DOCKERIGNORE

    # Генерируем astro.config.mjs с правильным base path
    # Простой подход: заменяем/добавляем base в существующем конфиге
    log "Генерация astro.config.mjs с base: '/${PAGE_HASH}/'"
    if [[ -f "$WORK_TREE/astro.config.mjs" ]]; then
      # Копируем оригинальный конфиг
      cp "$WORK_TREE/astro.config.mjs" "$WORK_TREE/astro.config.mjs.orig"
      
      # Заменяем base (если есть) или добавляем после site (если есть) или в начало объекта
      if grep -q "base:" "$WORK_TREE/astro.config.mjs"; then
        # Заменяем существующий base
        sed -i.bak "s|base:.*|base: '/${PAGE_HASH}/',|g" "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
        sed -i '' "s|base:.*|base: '/${PAGE_HASH}/',|g" "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
        sed "s|base:.*|base: '/${PAGE_HASH}/',|g" "$WORK_TREE/astro.config.mjs.orig" > "$WORK_TREE/astro.config.mjs"
      elif grep -q "site:" "$WORK_TREE/astro.config.mjs"; then
        # Добавляем base после site
        sed -i.bak "/site:/a\\
	base: '/${PAGE_HASH}/'," "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
        sed -i '' "/site:/a\\
	base: '/${PAGE_HASH}/'," "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
        awk "/site:/ {print; print \"\tbase: '/${PAGE_HASH}/',\"; next} {print}" "$WORK_TREE/astro.config.mjs.orig" > "$WORK_TREE/astro.config.mjs"
      else
        # Добавляем base в начало объекта defineConfig
        sed -i.bak "/defineConfig({/a\\
	base: '/${PAGE_HASH}/'," "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
        sed -i '' "/defineConfig({/a\\
	base: '/${PAGE_HASH}/'," "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
        awk "/defineConfig({/ {print; print \"\tbase: '/${PAGE_HASH}/',\"; next} {print}" "$WORK_TREE/astro.config.mjs.orig" > "$WORK_TREE/astro.config.mjs"
      fi
      rm -f "$WORK_TREE/astro.config.mjs.orig" "$WORK_TREE/astro.config.mjs.bak" 2>/dev/null || true
    elif [[ -f "$WORK_TREE/astro.config.ts" ]]; then
      # Конвертируем .ts в .mjs и добавляем base
      cp "$WORK_TREE/astro.config.ts" "$WORK_TREE/astro.config.mjs"
      # Заменяем base или добавляем
      if grep -q "base:" "$WORK_TREE/astro.config.mjs"; then
        sed -i.bak "s|base:.*|base: '/${PAGE_HASH}/',|g" "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
        sed -i '' "s|base:.*|base: '/${PAGE_HASH}/',|g" "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
        sed "s|base:.*|base: '/${PAGE_HASH}/',|g" "$WORK_TREE/astro.config.mjs" > "$WORK_TREE/astro.config.mjs.tmp" && mv "$WORK_TREE/astro.config.mjs.tmp" "$WORK_TREE/astro.config.mjs"
      else
        sed -i.bak "/defineConfig({/a\\
	base: '/${PAGE_HASH}/'," "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
        sed -i '' "/defineConfig({/a\\
	base: '/${PAGE_HASH}/'," "$WORK_TREE/astro.config.mjs" 2>/dev/null || \
        awk "/defineConfig({/ {print; print \"\tbase: '/${PAGE_HASH}/',\"; next} {print}" "$WORK_TREE/astro.config.mjs" > "$WORK_TREE/astro.config.mjs.tmp" && mv "$WORK_TREE/astro.config.mjs.tmp" "$WORK_TREE/astro.config.mjs"
      fi
      rm -f "$WORK_TREE/astro.config.mjs.bak" 2>/dev/null || true
    else
      # Если конфига нет, создаём базовый
      sed "s/__PAGE_HASH__/$PAGE_HASH/g" << 'ASTROCONFIG' > "$WORK_TREE/astro.config.mjs"
// @ts-check
import { defineConfig } from 'astro/config';

// Автоматически сгенерировано при деплое
export default defineConfig({
  base: '/__PAGE_HASH__/',
  output: 'static',
  trailingSlash: 'never',
  compressHTML: true
});
ASTROCONFIG
    fi

    # Очередь Redis (воркер ограничен 2 одновременными деплоями)
    REDIS_HOST="${REDIS_HOST:-127.0.0.1}"
    REDIS_PORT="${REDIS_PORT:-6379}"
    DEPLOY_TIMEOUT="${DEPLOY_TIMEOUT:-300}"  # 5 минут по умолчанию
    
    # Передаём PAGE_HASH и DEPLOY_ID в очередь (JSON)
    DEPLOY_META="{\"hash\":\"${PAGE_HASH}\",\"deploy_id\":\"${DEPLOY_ID}\"}"
    
    if redis-cli -h "$REDIS_HOST" -p "$REDIS_PORT" RPUSH deploy_queue "$DEPLOY_META" >/dev/null 2>&1; then
      log "Добавлено в очередь (deploy_id: ${DEPLOY_ID}), ожидание завершения деплоя..."
      
      # Ждём результат через BLPOP (блокирующее ожидание)
      # Используем уникальный ключ с deploy_id, чтобы каждый push ждал свой результат
      RESULT=$(timeout "$DEPLOY_TIMEOUT" redis-cli -h "$REDIS_HOST" -p "$REDIS_PORT" \
        BLPOP "${REDIS_RESULT_KEY}" "$DEPLOY_TIMEOUT" 2>/dev/null | tail -1 || echo "timeout")
      
      if [[ "$RESULT" == "ok" ]]; then
        DEPLOY_URL="https://${DOMAIN}/${PAGE_HASH}/"
        log "Деплой завершён успешно. Сайт: ${DEPLOY_URL}"
        echo "DEPLOY_URL:${DEPLOY_URL}" >&2
      elif [[ "$RESULT" == "failed" ]]; then
        log "Ошибка деплоя"
        echo "ERROR: Деплой завершился с ошибкой. Проверьте логи на сервере: /var/log/deploy/deploy.log и /var/log/deploy/worker-*.log" >&2
        exit 1
      else
        log "Таймаут ожидания деплоя (возможно, деплой ещё выполняется)"
        echo "WARNING: Таймаут ожидания деплоя (возможно, деплой ещё выполняется). Проверьте логи на сервере." >&2
        # Не возвращаем ошибку, т.к. деплой может завершиться позже
      fi
    else
      log "Redis недоступен, деплой напрямую..."
      if ! /opt/deploy_api/scripts/deploy_single.sh "$PAGE_HASH"; then
        exit 1
      fi
    fi
  fi
done

exit 0
