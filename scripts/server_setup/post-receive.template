#!/bin/bash
#
# post-receive хук для deploy при git push
# page_hash извлекается из имени bare repo (например 1d2637e8889b.git → 1d2637e8889b)
#

set -e

# GIT_DIR задаётся Git при вызове хука; canonicalize (убирает /. в конце)
REPO_ROOT="$(cd "${GIT_DIR:-$(cd "$(dirname "$0")/.." && pwd)}" && pwd)"
PAGE_HASH="$(basename "$REPO_ROOT" .git)"
# Docker tag не принимает пустое, "." и прочие некорректные значения
if [[ -z "$PAGE_HASH" || "$PAGE_HASH" == "." || "$PAGE_HASH" == ".." ]] || ! [[ "$PAGE_HASH" =~ ^[a-zA-Z0-9_.-]+$ ]]; then
  echo "[post-receive] ERROR: Invalid PAGE_HASH='$PAGE_HASH' (REPO_ROOT=$REPO_ROOT, GIT_DIR=$GIT_DIR)" >&2
  exit 1
fi
WORK_TREE="/opt/deploy/${PAGE_HASH}"
CONTAINER_NAME="deploy-${PAGE_HASH}"
IMAGE_NAME="deploy-${PAGE_HASH}"
REGISTRY_FILE="/opt/deploy/registry.json"
NGINX_DEPLOY_DIR="/etc/nginx/sites-available/deploy"

log() { echo "[post-receive $PAGE_HASH] $*"; }

while read oldrev newrev refname; do
  branch="${refname#refs/heads/}"
  if [ "$branch" = "main" ] || [ "$branch" = "master" ]; then
    log "Push в $branch, деплой..."

    # Checkout в work tree
    mkdir -p "$WORK_TREE"
    GIT_DIR="$REPO_ROOT" GIT_WORK_TREE="$WORK_TREE" git checkout -f "$branch" 2>/dev/null || \
    GIT_DIR="$REPO_ROOT" GIT_WORK_TREE="$WORK_TREE" git checkout -f main 2>/dev/null || \
    GIT_DIR="$REPO_ROOT" GIT_WORK_TREE="$WORK_TREE" git checkout -f master

    # Dockerfile с npm + BuildKit cache (npm cache + node_modules cache)
    log "Dockerfile: npm + BuildKit cache (node_modules)"
    cat > "$WORK_TREE/Dockerfile" << DOCKERFILE
# syntax=docker/dockerfile:1
FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN --mount=type=cache,target=/root/.npm \\
    --mount=type=cache,target=/app/node_modules,id=node-modules-${PAGE_HASH} \\
    npm install
COPY . .
RUN --mount=type=cache,target=/app/node_modules,id=node-modules-${PAGE_HASH} \\
    npm run build
RUN test -d dist || (echo "ERROR: dist not found" && exit 1)

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
RUN echo 'server { listen 8000; root /usr/share/nginx/html; index index.html; location / { try_files $uri $uri/ /index.html; } gzip on; }' > /etc/nginx/conf.d/default.conf
EXPOSE 8000
CMD ["nginx", "-g", "daemon off;"]
DOCKERFILE

    # .dockerignore — ускоряет сборку
    cat > "$WORK_TREE/.dockerignore" << 'DOCKERIGNORE'
node_modules
.git
dist
.astro
*.log
.env
DOCKERIGNORE

    # Docker build с BuildKit
    log "Сборка образа (npm + BuildKit cache)..."
    if ! DOCKER_BUILDKIT=1 docker build -t "$IMAGE_NAME" "$WORK_TREE"; then
      log "Ошибка сборки Docker"
      exit 1
    fi

    # Останавливаем старый контейнер
    docker stop "$CONTAINER_NAME" 2>/dev/null || true
    docker rm "$CONTAINER_NAME" 2>/dev/null || true

    # Порт: из реестра или новый (стабильный по хэшу)
    PORT=""
    if [ -f "$REGISTRY_FILE" ] && command -v jq >/dev/null 2>&1; then
      PORT="$(jq -r --arg h "$PAGE_HASH" '.[$h].container_port // empty' "$REGISTRY_FILE" 2>/dev/null)"
    fi
    if [ -z "$PORT" ] || [ "$PORT" = "null" ]; then
      # Детерминированный порт 9000–9999 по хэшу
      PORT=$((9000 + $(echo -n "$PAGE_HASH" | cksum | cut -d' ' -f1) % 999))
    fi

    # Обновляем реестр
    mkdir -p "$(dirname "$REGISTRY_FILE")"
    if command -v jq >/dev/null 2>&1; then
      if [ -f "$REGISTRY_FILE" ]; then
        jq --arg h "$PAGE_HASH" --argjson p "$PORT" --arg n "$CONTAINER_NAME" \
          '.[$h] = {container_port: $p, container_name: $n}' "$REGISTRY_FILE" > "${REGISTRY_FILE}.tmp"
        mv "${REGISTRY_FILE}.tmp" "$REGISTRY_FILE"
      else
        echo "{\"$PAGE_HASH\": {\"container_port\": $PORT, \"container_name\": \"$CONTAINER_NAME\"}}" > "$REGISTRY_FILE"
      fi
    else
      echo "{\"$PAGE_HASH\": {\"container_port\": $PORT, \"container_name\": \"$CONTAINER_NAME\"}}" >> "${REGISTRY_FILE}.new"
    fi

    # Запускаем контейнер
    log "Запуск контейнера на порту $PORT..."
    docker run -d \
      --name "$CONTAINER_NAME" \
      -p "127.0.0.1:${PORT}:8000" \
      --restart unless-stopped \
      "$IMAGE_NAME"

    # Nginx config
    CONFIG_FILE="${NGINX_DEPLOY_DIR}/${PAGE_HASH}.conf"
    mkdir -p "$NGINX_DEPLOY_DIR"
    cat > "$CONFIG_FILE" << NGINXEOF
# Location для /${PAGE_HASH}
location /${PAGE_HASH}/ {
    proxy_pass http://127.0.0.1:${PORT}/;
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto \$scheme;
    proxy_connect_timeout 60s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;
    rewrite ^/${PAGE_HASH}(/.*)\$ \$1 break;
}

location ~ ^/(_astro|assets|node_modules|public)/ {
    proxy_pass http://127.0.0.1:${PORT}\$request_uri;
    proxy_http_version 1.1;
    proxy_set_header Host \$host;
    proxy_set_header X-Real-IP \$remote_addr;
    proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto \$scheme;
    expires 1y;
    add_header Cache-Control "public, immutable";
}

location = /${PAGE_HASH} {
    return 301 /${PAGE_HASH}/;
}
NGINXEOF

    log "Готово! Сайт: http://DOMAIN/${PAGE_HASH}/"
  fi
done

exit 0
